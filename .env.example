# Dalil Pi — environment variables (put the real values in Vercel → Settings → Environment Variables)
# Never commit real values. Only NEXT_PUBLIC_* variables reach the browser.

# --- AI (required) ---
# Meta Model API key. The model is fixed in code: muse-spark-1.3-contributor
META_API_KEY=

# --- Pi Network (required) ---
# Server API Key from the Pi Developer Portal (open develop.pi in the Pi Browser) — Testnet app
PI_API_KEY=
# testnet | mainnet
PI_NETWORK=testnet
# Optional. Leave unset (= false) when you test inside the Pi Browser on your phone.
# Set to true only when testing on a desktop through the Pi Sandbox (sandbox.minepi.com).
# On Vercel add it as a "config" value (not a secret): it is public by design.
NEXT_PUBLIC_PI_SANDBOX=false

# --- Supabase (required) ---
# Project Settings → API. The service-role key stays on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Signing secret (required) ---
# Required in production: signs login sessions and offers (sign-in fails without it).
# Any long random string (32+ characters). Generate a NEW one for this project: openssl rand -hex 32
OFFER_SIGNING_SECRET=

# --- Limits (optional) ---
FREE_SEARCHES_PER_MONTH=5
FREE_ORDERS_PER_MONTH=5
HOURLY_SEARCH_LIMIT=10
# Max AI searches for the whole site per day (protects the Meta bill)
GLOBAL_DAILY_AI_LIMIT=500
# Max AI searches per visitor IP per day (extra safety)
HOSTED_DAILY_LIMIT=40

# --- Real browser for the agent (optional) ---
# BROWSER_WS_ENDPOINT=
# DALIL_BROWSER=off

# --- Local development only (ignored on Vercel) ---
# ALLOW_DEV_LOGIN=1   # shows a "Dev sign-in" button so you can test outside the Pi Browser

# Optional: email shown on /privacy and /terms (Pi Developer Portal needs both links)
NEXT_PUBLIC_CONTACT_EMAIL=

# Partner data APIs (docs/PARTNER_APIS.md) — leave empty until the partner gives access
MAPOFPI_API_URL=
MAPOFPI_API_KEY=
MAPOFPI_APP_URL=
SALLA_API_URL=
SALLA_API_KEY=

# Pi Chain Mall (https://pipcm.com) — searched first for every product request, using its
# public product search (no key). Set PCM_SEARCH=off to turn it off.
PCM_SEARCH=
# Smaller Pi marketplaces with public catalogs (Global Trade Pi). MARKETPLACES_SEARCH=off turns them off.
MARKETPLACES_SEARCH=
# Piketplace countries copied into Dalil Index (comma-separated ISO codes, max 6; default EG).
PIKET_COUNTRIES=
# Owner dashboard at /admin (falls back to CRON_SECRET when empty).
ADMIN_SECRET=

# Daily cron (vercel.json → /api/cron/daily). Any long random string; Vercel sends it automatically.
CRON_SECRET=

# Approve merchant sign-ups automatically (default: they wait for review in the merchants table)
MERCHANTS_AUTO_APPROVE=

# Telegram notifications (daily digest: price drops, target prices, shop answers, plan reminders)
TELEGRAM_BOT_TOKEN=          # from @BotFather (secret)
TELEGRAM_BOT_USERNAME=       # without @, e.g. DalilPiBot
TELEGRAM_WEBHOOK_SECRET=     # any long random string (letters, digits, _ and -)
APP_URL=                     # optional, e.g. https://pihackathontest.vercel.app
