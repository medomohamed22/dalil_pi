# Dalil Pi — environment variables (put the real values in Vercel → Settings → Environment Variables)
# Never commit real values. Only NEXT_PUBLIC_* variables reach the browser.

# --- AI (required) ---
# Meta Model API key. The model is fixed in code: muse-spark-1.3-contributor
META_API_KEY=

# --- Pi Network (required) ---
# Server API Key from the Pi Developer Portal (open develop.pi in the Pi Browser) — Testnet app
PI_API_KEY=
# testnet | mainnet
PI_NETWORK=testnet
# true while testing in the Pi Sandbox (sandbox.minepi.com); false on Mainnet
NEXT_PUBLIC_PI_SANDBOX=true

# --- Supabase (required) ---
# Project Settings → API. The service-role key stays on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Signing secret (required) ---
# Signs sessions and offers. Generate a NEW one for this project: openssl rand -hex 32
OFFER_SIGNING_SECRET=

# --- Limits (optional) ---
FREE_SEARCHES_PER_MONTH=5
FREE_ORDERS_PER_MONTH=2
HOURLY_SEARCH_LIMIT=10
# Max AI searches for the whole site per day (protects the Meta bill)
GLOBAL_DAILY_AI_LIMIT=500
# Max AI searches per visitor IP per day (extra safety)
HOSTED_DAILY_LIMIT=40

# --- Real browser for the agent (optional) ---
# BROWSER_WS_ENDPOINT=
# DALIL_BROWSER=off

# --- Local development only (ignored on Vercel) ---
# ALLOW_DEV_LOGIN=1   # shows a "Dev sign-in" button so you can test outside the Pi Browser
