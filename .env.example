# --- PayPal (required) ---
# Sandbox app: https://developer.paypal.com/dashboard/applications/sandbox  (enable "Vault" for auto-buy)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Signs offers so prices can't be tampered with before checkout (openssl rand -hex 32)
OFFER_SIGNING_SECRET=

# EGP prices are charged in USD at this rate (PayPal does not settle EGP)
EGP_PER_USD=50

# Public URL of the app (PayPal return/cancel URLs). Optional on Vercel.
APP_URL=

# --- Price watches ---
# Upstash Redis (Vercel → Storage → Upstash). Either naming works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Protects /api/cron (Vercel Cron sends it automatically; add the same value as a
# GitHub Actions repository secret for the 10-minute price-watch workflow)
CRON_SECRET=

# --- AI for visitors without their own key (rate-limited) ---
META_API_KEY=
HOSTED_DAILY_LIMIT=40
HOSTED_GLOBAL_DAILY_LIMIT=500
# The model is fixed in code: muse-spark-1.3-contributor

# --- Channel3 product catalog (US): https://trychannel3.com/dashboard/api ---
CHANNEL3_API_KEY=

# --- Real browser (optional): remote browser instead of bundled Chromium, or "off" ---
# BROWSER_WS_ENDPOINT=
# DALIL_BROWSER=off

# --- Web Push (optional): npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Guided demo (sandbox only): the PayPal SANDBOX buyer the judges log in with.
# Shown in the demo panel only when PAYPAL_ENV is not "live". Never a real account.
DEMO_PAYPAL_BUYER_EMAIL=
DEMO_PAYPAL_BUYER_PASSWORD=
